# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── Database ───
MONGO_URI=mongodb://localhost:27017/supportflow

# ─── JWT ───
JWT_ACCESS_SECRET=dev_access_secret_change_this_in_production_min_32_chars_long
JWT_REFRESH_SECRET=dev_refresh_secret_change_this_in_production_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Redis (BullMQ) ───
REDIS_URL=redis://localhost:6379
USE_QUEUE=true

# ─── Email (SMTP) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=SupportFlow <noreply@supportflow.com>

# ─── Client URL ───
CLIENT_URL=http://localhost:5173

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxx

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx